{
  "kind": "collectionType",
  "collectionName": "chung_chis",
  "info": {
    "singularName": "chung-chi",
    "pluralName": "chung-chis",
    "displayName": "Chung-chi"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "ho_ten": {
      "type": "string",
      "required": true
    },
    "ngay_sinh": {
      "type": "date",
      "required": true
    },
    "gioi_tinh": {
      "type": "string"
    },
    "cccd": {
      "type": "string",
      "required": true,
      "private": true
    },
    "diem_trac_nghiem": {
      "type": "decimal"
    },
    "diem_thuc_hanh": {
      "type": "decimal"
    },
    "so_hieu_chung_chi": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "so_vao_so_goc": {
      "type": "string"
    },
    "khoa_thi_ngay": {
      "type": "date"
    },
    "ten_chung_chi": {
      "type": "string",
      "default": "Chứng chỉ Ứng dụng Công nghệ thông tin"
    },
    "trang_thai": {
      "type": "enumeration",
      "enum": ["hoan_thanh", "dang_hoc"],
      "default": "hoan_thanh"
    },
    "ghi_chu": {
      "type": "text"
    },
    "file_chung_chi": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images", "files"]
    }
  }
}