{
  "kind": "collectionType",
  "collectionName": "chung_chis",
  "info": {
    "singularName": "chung-chi",
    "pluralName": "chung-chis",
    "displayName": "Chung-chi"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "ho_ten": {
      "type": "string",
      "required": true
    },
    "so_dien_thoai": {
      "type": "string",
      "required": true
    },
    "cccd": {
      "type": "string",
      "required": true,
      "private": true
    },
    "ma_chung_chi": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "khoa_hoc": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::khoa-hoc.khoa-hoc"
    },
    "ngay_cap": {
      "type": "date",
      "required": true
    },
    "trang_thai": {
      "type": "enumeration",
      "enum": ["hoan_thanh", "dang_hoc"],
      "default": "hoan_thanh"
    },
    "file_chung_chi": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images", "files"]
    }
  }
}
